// Omitl — Compact contract template
// One table per endpoint, one page per endpoint (pagebreak after each).
#set document(title: "{{ contract.title }}")
#set page(
  paper: "a4",
  margin: (top: 1.5cm, bottom: 1.2cm, left: 1cm, right: 1cm),
{% if watermark_path %}
  background: place(center + horizon,
    rotate(-40deg,
      box(width: 70%, opacity: 0.06,
        image("{{ watermark_path }}", width: 100%)
      )
    )
  ),
{% endif %}
  header: context [
    #set text(size: 7.5pt, fill: luma(140))
    #grid(
      columns: ({% if logo_path %}auto, {% endif %}1fr, auto),
      gutter: 6pt,
      {% if logo_path %}
      image("{{ logo_path }}", height: 16pt),
      {% endif %}
      align(horizon)[{{ contract.title }} — v{{ contract.version }} | {{ contract.base_url }}],
      align(horizon)[{{ brand.company_name }}],
    )
    #v(1pt)
    #line(length: 100%, stroke: 0.4pt + luma(200))
  ],
  footer: context [
    #line(length: 100%, stroke: 0.4pt + luma(200))
    #v(1pt)
    #set text(size: 7.5pt, fill: luma(140))
    #grid(
      columns: (1fr, auto),
      [{{ document_date }}],
      [Pág. #counter(page).display()],
    )
  ]
)
#set text(font: "{{ brand.font_family }}", size: 10pt)

#let c_head    = rgb("{{ brand.primary_color }}")
#let c_section = rgb("#9d9d9d")
#let c_border  = rgb("#666666")
#let c_bg      = rgb("#f5f5f5")

// ── Endpoints ──────────────────────────────────────────────────────────────
{% for ep in contract.endpoints %}

// ── Collect param groups before building the table ─────────────────────────
{% set_global has_url  = false %}
{% set_global has_body = false %}
{% set_global has_hdr  = false %}
{% for p in ep.parameters %}
  {% if p.location == "path" or p.location == "query" %}{% set_global has_url  = true %}{% endif %}
  {% if p.location == "body"   %}{% set_global has_body = true %}{% endif %}
  {% if p.location == "header" %}{% set_global has_hdr  = true %}{% endif %}
{% endfor %}

#table(
  columns: (130pt, 1fr, 1fr),
  stroke: c_border,
  inset: 7pt,

  // ── Contract header ────────────────────────────────────────────────────
  table.cell(colspan: 3, fill: c_head)[
    #text(fill: white, weight: "bold")[Contrato WS para: {{ ep.title }}]
  ],

  // ── Method + URL ───────────────────────────────────────────────────────
  table.cell(fill: c_head)[
    #text(fill: white, weight: "bold")[Método: {{ ep.method | upper }}]
  ],
  table.cell(colspan: 2)[
    *URL:* `{{ contract.base_url }}{{ ep.path }}`{% if ep.description %}
    #linebreak()_{{ ep.description }}_{% endif %}
  ],

  // ── URL / Query parameters ─────────────────────────────────────────────
  table.cell(colspan: 3, fill: c_section, align: center)[
    #text(fill: white, weight: "bold")[Parámetros URL]
  ],
  [*Nombre*], [*Tipo*], [*Restricción*],
  {% if has_url %}
    {% for p in ep.parameters %}
      {% if p.location == "path" or p.location == "query" %}
  [`{{ p.name }}`],
  [{{ p.type }}],
  [{% if p.required %}Requerido{% else %}Opcional{% endif %}{% if p.description %}. {{ p.description }}{% endif %}],
      {% endif %}
    {% endfor %}
  {% else %}
  table.cell(colspan: 3)[Ninguno],
  {% endif %}

  // ── Body parameters ────────────────────────────────────────────────────
  table.cell(colspan: 3, fill: c_section, align: center)[
    #text(fill: white, weight: "bold")[Parámetros Body (JSON)]
  ],
  [*Nombre*], [*Tipo*], [*Restricción*],
  {% if has_body %}
    {% for p in ep.parameters %}
      {% if p.location == "body" %}
  [`{{ p.name }}`],
  [{{ p.type }}],
  [{% if p.required %}Requerido{% else %}Opcional{% endif %}{% if p.description %}. {{ p.description }}{% endif %}],
      {% endif %}
    {% endfor %}
  {% else %}
  table.cell(colspan: 3)[Ninguno],
  {% endif %}

  // ── Example section ────────────────────────────────────────────────────
  table.cell(colspan: 3, fill: c_section, align: center)[
    #text(fill: white, weight: "bold")[Ejemplo de consumo]
  ],
  table.cell(colspan: 3, align: top)[
    *Petición*
    {% if has_hdr %}
    #linebreak()*Headers:*
      {% for p in ep.parameters %}
        {% if p.location == "header" %}
    #linebreak()#text(size: 8pt)[#raw("{{ p.name }}: {% if p.description %}{{ p.description }}{% else %}<valor>{% endif %}")]
        {% endif %}
      {% endfor %}
    {% endif %}
  ],
  table.cell(colspan: 3, align: top)[
    *Respuesta*
    {% if ep.responses %}
    {% set_global prev_resp_status = 0 %}
      {% for r in ep.responses %}
        {% if r.status == prev_resp_status %}
    #linebreak()#text(size: 8pt, fill: luma(140))[_O bien:_]
        {% endif %}
    #linebreak()#text(weight: "bold")[{{ r.status }} — {{ r.description }}]
        {% if r.body %}
    #linebreak()#raw(block: true, lang: "json", "{{ r.body | typst_json }}")
        {% endif %}
    {% set_global prev_resp_status = r.status %}
      {% endfor %}
    {% else %}
    #linebreak()_Sin ejemplos definidos_
    {% endif %}
  ],
)
{% if not loop.last %}#pagebreak(){% endif %}
{% endfor %}
